# Public URLs are independent of the public/pages/ folder.
# Redirect old addresses permanently, preserving query strings.
/pages/about.html /about 301
/pages/about /about 301
/pages/about/ /about 301
/about.html /about 301
/about/ /about 301
/pages/contact.html /contact 301
/pages/contact /contact 301
/pages/contact/ /contact 301
/contact.html /contact 301
/contact/ /contact 301

# Serve existing HTML files at clean URLs without moving them.
# Extensionless targets avoid Cloudflare's automatic .html redirects.
/about /pages/about 200
/contact /pages/contact 200
/products /products/ 200
/blog /blog/ 200

/pages/* /:splat 301
